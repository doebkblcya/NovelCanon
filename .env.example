# NovelCanon 本地环境模板：复制为 .env 并填入真实值（.env 已被 gitignore，不会提交）
#
# 阶段 06 Map 抽取的 generation provider（OpenAI 兼容；DeepSeek 示例）：
#   export 到 shell 或写入 .env 均可，优先级：环境变量 > .env。

# provider 适配器（openai-compatible）
NOVELCANON_LLM_PROVIDER=openai-compatible

# DeepSeek OpenAI 兼容端点（chat completions 为 {base_url}/chat/completions）
NOVELCANON_LLM_BASE_URL=https://api.deepseek.com/v1
NOVELCANON_LLM_MODEL=deepseek-chat

# API key：只从本文件/环境读取，绝不落库、不进日志、不进入请求 hash
NOVELCANON_LLM_API_KEY=sk-xxx

# 上下文窗口 / 最大输出 / 结构化输出模式（deepseek-chat 支持 json_object）
NOVELCANON_LLM_CONTEXT_WINDOW=32768
NOVELCANON_LLM_MAX_OUTPUT=8192
NOVELCANON_LLM_MODE=json_object

# tokenizer 计量（fake-v1 = 字符数近似；正式计量建议 tiktoken-o200k_base）
NOVELCANON_LLM_TOKENIZER=fake-v1

# ── embedding provider（阶段 11 复审 D：生产检索后端）────────────────
# 配置后 CLI index / API 检索走真实 embedding（factory 注册生产 adapter）；
# 不配置则回退 fake-embed-v8（测试 / fixture Pilot 用）。

# 生产后端开关：profile_id（写入 index_versions.embedding_profile_id，
# 查询侧按此校验 profile 与维数一致）
NOVELCANON_EMBEDDING_PROFILE_ID=text-embedding-v4

# OpenAI 兼容 /embeddings 端点（阿里百炼 DashScope 示例）
NOVELCANON_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
NOVELCANON_EMBEDDING_MODEL=text-embedding-v4

# 向量维数：必须与模型输出一致（text-embedding-v4 = 1024），
# adapter 会校验返回维数，不一致即拒绝
NOVELCANON_EMBEDDING_DIMENSION=1024

# API key：只从本文件/环境读取，绝不落库、不进日志、不进入 config hash
NOVELCANON_EMBEDDING_API_KEY=sk-xxx
