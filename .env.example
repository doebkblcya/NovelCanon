# NovelCanon 本地环境模板：复制为 .env 并填入真实值（.env 已被 gitignore，不会提交）
#
# 阶段 06 Map 抽取的 generation provider（OpenAI 兼容；DeepSeek 示例）：
#   export 到 shell 或写入 .env 均可，优先级：环境变量 > .env。

# provider 适配器（openai-compatible）
NOVELCANON_LLM_PROVIDER=openai-compatible

# DeepSeek OpenAI 兼容端点（chat completions 为 {base_url}/chat/completions）
NOVELCANON_LLM_BASE_URL=https://api.deepseek.com/v1
NOVELCANON_LLM_MODEL=deepseek-chat

# API key：只从本文件/环境读取，绝不落库、不进日志、不进入请求 hash
NOVELCANON_LLM_API_KEY=sk-xxx

# 上下文窗口 / 最大输出 / 结构化输出模式（deepseek-chat 支持 json_object）
NOVELCANON_LLM_CONTEXT_WINDOW=8192
NOVELCANON_LLM_MAX_OUTPUT=2048
NOVELCANON_LLM_MODE=json_object

# tokenizer 计量（fake-v1 = 字符数近似；正式计量建议 tiktoken-o200k_base）
NOVELCANON_LLM_TOKENIZER=fake-v1
